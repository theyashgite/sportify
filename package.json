{
  "name": "sportify-management",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "migrate:atlas": "npm run migrate:atlas --workspace server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
